# ===== Polymarket 套利系统环境变量 =====
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交私钥。
# 所有变量统一使用 PM_ 前缀。

# --- 钱包 / 链上（交易功能必需）---
# Polygon 交易钱包私钥（请使用小额专用钱包）；可带或不带 0x 前缀
PM_PRIVATE_KEY=
# Polygon 主网 chain id
PM_CHAIN_ID=137
# 签名类型：0=EOA 钱包直连；1=Polymarket Email/Proxy 钱包；2=Gnosis Safe
PM_SIGNATURE_TYPE=0
# Proxy / Safe 钱包的资金地址（funder，signature_type=1/2 时必填）
PM_FUNDER_ADDRESS=
# Polygon RPC 节点（建议商用节点：Alchemy / QuickNode；公共节点仅用于测试）
PM_POLYGON_RPC_URL=https://polygon-rpc.com

# --- CLOB L2 API 凭证 ---
# 可留空：系统后续可用私钥通过 L1 签名自动派生/注册 API key
PM_CLOB_API_KEY=
PM_CLOB_API_SECRET=
PM_CLOB_API_PASSPHRASE=

# --- 运行参数 ---
# 网络受限时走本地代理（Clash 等）；直连正常则留空
PM_PROXY_URL=
PM_LOG_LEVEL=INFO
# 生产环境设为 true 输出 JSON 结构化日志
PM_LOG_JSON=false
# HTTP 请求超时（秒）
PM_HTTP_TIMEOUT=10.0
